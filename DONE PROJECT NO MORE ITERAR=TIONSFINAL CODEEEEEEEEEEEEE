void showPeriodic() {
  Serial.println(F("\n==== PERIODIC TABLE ===="));
  for (int i = 0; i < sizeof(PERIODIC)/sizeof(PERIODIC[0]); i++) {
    Serial.print(PERIODIC[i].number);
    Serial.print(F(": "));
    Serial.print(PERIODIC[i].symbol);
    Serial.print(F(" - "));
    Serial.print(PERIODIC[i].name);
    Serial.print(F(" ("));
    Serial.print(PERIODIC[i].atomicMass);
    Serial.println(F(")"));
  }
  Serial.println(F("=======================\n"));
}

